# FixHome Backend Environment Configuration
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
PORT=3000

# Database (Supabase PostgreSQL - Connection Pooler)
DATABASE_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DATABASE_PORT=6543
DATABASE_NAME=postgres
DATABASE_USER=postgres.ebtlbfsblkhgzlnfgjpn
DATABASE_PASSWORD=
DATABASE_SSL=true

# JWT Authentication
# Set two different random secrets (at least 32 characters); no default secret is used.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Private Supabase Storage for KYC (server-side only; do not expose service role key to clients)
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY must be configured only on the backend
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KYC_BUCKET=kyc-private
SUPABASE_KYC_SIGNED_URL_TTL_SECONDS=300

# Cloudinary (required for public media, repair evidence & booking photos; KYC stays on Supabase)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps (optional, unused — superseded by MapTiler below)
GOOGLE_MAPS_API_KEY=

# ── Google Sign-In ───────────────────────────────────────────────────────────
# Một cặp dùng chung cho cả đội, KHÔNG phải mỗi máy một cặp. Ai pull repo về thì
# xin giá trị từ người tạo rồi điền vào đây là chạy, không cần khai báo gì thêm
# trên Google Cloud Console.
#
# Cách tạo: console.cloud.google.com > tạo project (chọn "No organisation")
# > APIs & Services > OAuth consent screen > External > thêm Gmail của cả nhóm
# vào Test users > Credentials > Create credentials > OAuth client ID
# > loại "Web application", rồi khai đúng hai giá trị sau:
#
#   Authorized JavaScript origins:  http://localhost:5173
#   Authorized redirect URIs:       http://localhost:3000/api/v1/auth/google/callback
#
# CLIENT_ID là công khai (nó nằm trong bundle web mà trình duyệt tải về).
# CLIENT_SECRET chỉ backend giữ — gửi riêng cho đồng đội, đừng commit.
# Bỏ trống cả hai thì backend vẫn chạy bình thường, chỉ các endpoint
# /auth/google trả 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phải trùng từng ký tự với ô Authorized redirect URIs ở trên.
#
# Giữ nguyên "localhost" chứ đừng đổi sang IP: Google chỉ chấp nhận http cho
# localhost và 127.0.0.1, mọi địa chỉ khác bắt buộc phải là https.
#
# Hệ quả khi test trên emulator Android: "localhost" bên trong emulator trỏ vào
# chính emulator chứ không phải máy thật, nên sau khi đăng nhập Google, trình
# duyệt sẽ không tìm thấy backend. Chạy một lệnh này trước khi test là xong:
#
#   adb reverse tcp:3000 tcp:3000
#
# (Expo đã tự làm điều tương tự cho cổng 8081, nhưng cổng 3000 thì phải tự chạy.)
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Những tiền tố mà backend được phép đưa người dùng quay về sau khi đăng nhập.
# Expo Go sinh địa chỉ theo IP LAN của từng máy (exp://192.168.x.x:8081) nên chỉ
# khớp được theo tiền tố; nhận bừa mọi địa chỉ là mở đường cho kẻ tấn công lái
# mã đăng nhập sang máy của họ.
GOOGLE_ALLOWED_APP_REDIRECTS=exp://,fixhome://,http://localhost:5173,http://localhost:8081

# MapTiler (optional – server-side REST key for the /geo geocoding proxy).
# Get a free key at https://cloud.maptiler.com/account/keys
MAPTILER_API_KEY=

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
# Private DEV1 repair evidence. Backend only; never expose the service role key to clients.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCE_BUCKET=repair-evidence
# Private bucket for customer booking photos
SUPABASE_BOOKING_PRIVATE_BUCKET=booking-private
# Public bucket for customer booking photos (bucket policy must be set to public in Supabase dashboard)
SUPABASE_MEDIA_BUCKET=media-public

# Frontend base URL (backend redirects here after VNPay return)
FRONTEND_URL=http://localhost:5173

# VNPay (sandbox: https://sandbox.vnpayment.vn — register a test merchant at
# https://sandbox.vnpayment.vn/devreg to get VNPAY_TMN_CODE/VNPAY_HASH_SECRET).
# Also requires the payment.mode business config (system_config table) set to LIVE.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/v1/finance/vnpay/return
# Server-to-server "querydr" API — reconciles payment status on the browser return leg
# when the IPN webhook can't reach this backend (e.g. localhost in local dev).
VNPAY_QUERYDR_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
