# FixHome Backend Environment Configuration
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fixhome
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# JWT Authentication
# Set two different random secrets (at least 32 characters); no default secret is used.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Cloudinary (cloud name required to submit verification metadata; no binary upload here)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps (optional – configure when implementing location features)
GOOGLE_MAPS_API_KEY=

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
