# FixHome Backend Environment Configuration
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
PORT=3000

# Database (Supabase PostgreSQL - Connection Pooler)
DATABASE_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DATABASE_PORT=6543
DATABASE_NAME=postgres
DATABASE_USER=postgres.ebtlbfsblkhgzlnfgjpn
DATABASE_PASSWORD=

# JWT Authentication
JWT_SECRET=fixhome-jwt-secret-change-in-production
JWT_EXPIRATION=1d

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Cloudinary (optional – configure when implementing media upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps (optional – configure when implementing location features)
GOOGLE_MAPS_API_KEY=

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
